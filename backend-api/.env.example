# Copy this file to .env and fill in your own values. Never commit the real .env.

# Get this from https://console.anthropic.com/ — treat it as a secret.
ANTHROPIC_API_KEY=

# Any current Claude model with vision support, e.g. claude-sonnet-5 or claude-opus-5
CLAUDE_MODEL=claude-sonnet-5

# Optional. Seconds to wait for a Claude response before returning AI_TIMEOUT.
CLAUDE_TIMEOUT_SECONDS=25

# Optional. Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Used by app/redis_worker.py (the Redis job consumer — see /CONTRACT.md).
# Not needed to run the standalone HTTP /analyze endpoint.
# Port 6380 to avoid colliding with any Redis already running on the
# system's default 6379 (e.g. `docker compose up redis` maps to 6380:6379).
REDIS_URL=redis://localhost:6380
RESULT_TTL_SECONDS=120
